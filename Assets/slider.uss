:root {
}

/* View All Apps button — Classic (purple) theme */
#viewAppsBtn {
    background-color: rgba(22, 18, 48, 0.85);
    border-left-color: rgba(125, 101, 182, 0.8);
    border-right-color: rgba(125, 101, 182, 0.8);
    border-top-color: rgba(125, 101, 182, 0.8);
    border-bottom-color: rgba(125, 101, 182, 0.8);
    color: rgb(200, 180, 255);
    transition-property: background-color, scale, border-color;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
}

#viewAppsBtn:hover {
    background-color: rgba(125, 101, 182, 0.7);
    scale: 1.04;
    border-left-color: rgba(200, 180, 255, 0.9);
    border-right-color: rgba(200, 180, 255, 0.9);
    border-top-color: rgba(200, 180, 255, 0.9);
    border-bottom-color: rgba(200, 180, 255, 0.9);
}

#viewAppsBtn:active {
    background-color: rgba(125, 101, 182, 1.0);
    scale: 0.97;
}

Slider Label {
    color: rgba(255, 153, 153, 0);
    display: none;
}

#soundDecBtn,
#soundIncBtn,
#brightnessDecBtn,
#brightnessIncBtn {
    transition-property: background-color;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
}

#soundDecBtn:hover,
#soundIncBtn:hover,
#brightnessDecBtn:hover,
#brightnessIncBtn:hover {
    background-color: rgba(175, 150, 230, 0.9);
}

/* Selected state (classic theme) for the zoom picker — toggled via class */
#zoom100Btn.zoom-selected,
#zoom125Btn.zoom-selected,
#zoom150Btn.zoom-selected,
#zoom200Btn.zoom-selected {
    background-color: rgba(175, 150, 230, 1.0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1.08;
}

Slider #unity-tracker {
    background-color: rgba(125, 101, 182, 0.85);
    background-size: 100% 100%;
    -unity-background-scale-mode: stretch-to-fill;
    position: absolute;
    scale: 0.88 15;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

Slider #unity-drag-container {
    background-color: rgba(162, 224, 242, 0.6);
    scale: 0.9 0.3;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-right-radius: 48px;
    border-bottom-left-radius: 48px;
    transform-origin: center;
}

Slider #unity-dragger {
    background-color: rgba(255, 255, 255, 0.6);
    position: absolute;
    scale: 4 10;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

Toggle Label {
    color: rgba(27, 27, 27, 0);
    opacity: 0;
}

Toggle #unity-checkmark {
    background-image: none;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(144, 152, 211, 0.82);
    border-right-color: rgba(144, 152, 211, 0.82);
    border-top-color: rgba(144, 152, 211, 0.82);
    border-bottom-color: rgba(144, 152, 211, 0.82);
    position: absolute;
    scale: 1 1;
}

TextField #unity-text-input {
    color: rgb(88, 94, 160);
    font-size: 43px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(144, 152, 211, 0);
    border-right-color: rgba(144, 152, 211, 0);
    border-top-color: rgba(144, 152, 211, 0);
    border-bottom-color: rgba(144, 152, 211, 0);
}
