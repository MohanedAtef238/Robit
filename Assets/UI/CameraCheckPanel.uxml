<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:engine="UnityEngine.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">

    <!--
        Camera Check Panel
        Overlaid on top of GazeCalibrationScene while calibration hasn't started yet.
    -->
    <engine:VisualElement name="camera-check-overlay"
        style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;
               justify-content: center; align-items: center;
               background-color: rgba(6, 10, 18, 0.90);">

        <!-- Added min-height to strictly enforce the card size and prevent squashing -->
        <engine:VisualElement name="camera-card"
            style="width: 640px; min-height: 520px; max-width: 95%;
                   padding-left: 30px; padding-right: 30px;
                   padding-top: 30px; padding-bottom: 30px;
                   background-color: rgba(18, 24, 38, 1.0);
                   border-radius: 18px;
                   border-width: 2px;
                   border-color: rgb(64, 96, 136);
                   flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;">

            <!-- Title -->
            <engine:Label name="camera-title" text="Camera Setup"
                style="font-size: 26px; -unity-font-style: bold;
                       color: rgb(240, 248, 255); margin-bottom: 10px; flex-shrink: 0;
                       -unity-text-align: middle-center;" />

            <!-- Status line (updated at runtime) -->
            <engine:Label name="camera-status" text="Starting camera&#8230;"
                style="font-size: 16px; color: rgb(180, 205, 225);
                       margin-bottom: 25px; white-space: normal; flex-shrink: 0;
                       -unity-text-align: middle-center;" />

            <!-- Live preview box — backgroundImage set from Texture2D in C# -->
            <engine:VisualElement name="camera-preview"
                style="width: 400px; height: 300px; min-height: 300px; align-self: center;
                       background-color: rgb(8, 12, 20);
                       border-radius: 12px;
                       border-width: 2px;
                       border-color: rgb(42, 68, 98);
                       margin-bottom: 25px; flex-shrink: 0;" />

            <!-- Error detail (hidden until CAM_ERROR received) -->
            <engine:Label name="camera-error" text=""
                style="display: none; font-size: 15px; color: rgb(255, 110, 90);
                       white-space: normal; margin-bottom: 15px; flex-shrink: 0;
                       -unity-text-align: middle-center;" />

            <!-- Retry button (hidden until error) -->
            <engine:Button name="camera-retry-btn" text="Retry"
                style="display: none; width: 100%; height: 50px; margin-bottom: 10px; flex-shrink: 0;
                       border-radius: 10px;
                       border-width: 0;
                       background-color: rgb(195, 75, 55);
                       color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 18px;" />

            <!-- Continue button (disabled until CAM_OK) -->
            <engine:Button name="camera-continue-btn" text="Continue &#8594;"
                style="width: 100%; height: 55px; flex-shrink: 0;
                       border-radius: 12px;
                       border-width: 0;
                       background-color: rgb(46, 189, 143);
                       color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 20px;" />

            <!-- Footer hint -->
            <engine:Label name="camera-footer"
                text="Your camera must be working before gaze calibration can begin."
                style="margin-top: 20px; font-size: 13px;
                       color: rgb(120, 150, 175); white-space: normal; flex-shrink: 0;
                       -unity-text-align: middle-center;" />
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
