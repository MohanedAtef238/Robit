<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/UI/slider.uss?fileID=7433441132597879392&amp;guid=ce99409ae47d3874d97a32649df04956&amp;type=3#slider"/>
    <Style src="project://database/Assets/UI/documents/HoverStyle.uss?fileID=7433441132597879392&amp;guid=f839dfd7a9425d146b9d7b099f5fbf17&amp;type=3#HoverStyle"/>
    <Style src="project://database/Assets/UI/starter.uss?fileID=7433441132597879392&amp;guid=a08abad5717a70d47a173c4f4d4a8832&amp;type=3#starter"/>
    <Style src="project://database/Assets/UI/buttonSwap.uss?fileID=7433441132597879392&amp;guid=6196617ce9a402b4dad4811a91c8e22c&amp;type=3#buttonSwap"/>
    <Style src="project://database/Assets/UI/documents/home-dashboard.uss?fileID=7433441132597879392&amp;guid=638afb89b35376049a8412c1df5543e0&amp;type=3#home-dashboard"/>
    <ui:VisualElement picking-mode="Ignore" class="bubble-element dashboard-element-1">
        <ui:VisualElement class="dashboard-element-2"/>
        <ui:VisualElement name="VisualElement" class="dashboard-element-3"/>
        <ui:VisualElement name="VisualElement" class="dashboard-element-4"/>
        <ui:VisualElement name="VisualElement" class="dashboard-element-5"/>
        <ui:VisualElement name="VisualElement" class="dashboard-element-6"/>
    </ui:VisualElement>
    <ui:VisualElement name="clock-tab" class="bubble-element clock-tab-style-7"/>
    <ui:VisualElement name="clock-panel" class="hover-scaler bubble-element clock-panel-style-8" style="display: flex; background-image: url(&quot;project://database/Assets/UI/assets/clock/clock%20frame.svg?fileID=7388822144124034973&amp;guid=0e42e1c03991606489b3e95c1be62d5b&amp;type=3#clock frame&quot;);">
        <ui:Button text="Button" name="locationPin" class="locationPin-style-9" style="background-image: url(&quot;project://database/Assets/UI/assets/clock/pointer.svg?fileID=7388822144124034973&amp;guid=9ea9fe602e6be0d4b980847a92732403&amp;type=3#pointer&quot;);">
            <ui:Label text="Label" name="locationLabel" class="locationLabel-style-10"/>
        </ui:Button>
        <ui:Button text="Button" name="clock" class="clock-style-11" style="background-image: url(&quot;project://database/Assets/UI/assets/clock/clock.svg?fileID=7388822144124034973&amp;guid=46321f6703c1cfa45b15c419b491b747&amp;type=3#clock&quot;);">
            <ui:Label text="Label" name="digitalClockLabel" class="digitalClockLabel-style-12"/>
            <ui:Label text="amPM" name="digitalClockM" class="digitalClockM-style-13"/>
            <ui:Button text="Button" name="minuteHand" class="minuteHand-style-14" style="background-image: url(&quot;project://database/Assets/UI/assets/clock/seconds.svg?fileID=7388822144124034973&amp;guid=d8aa672018aaa5748aededd641d6d41d&amp;type=3#seconds&quot;);"/>
            <ui:Button text="Button" name="hourHand" class="hourHand-style-15"/>
            <ui:Button text="Button" class="dashboard-element-16" style="background-image: url(&quot;project://database/Assets/UI/assets/wiggler/circle.svg?fileID=7388822144124034973&amp;guid=8a9555bc7595be746ae4c584c1987e3a&amp;type=3#circle&quot;);"/>
        </ui:Button>
        <ui:Button text="" name="weather" class="weather-style-17" style="background-image: url(&quot;project://database/Assets/UI/assets/clock/weather.svg?fileID=7388822144124034973&amp;guid=1ba991b9373b8f3458ab66cd7f1c1fea&amp;type=3#weather&quot;);">
            <ui:Label text="2" name="celsiusLabel" class="celsiusLabel-style-18"/>
            <ui:Label text="1" name="degreeLabel" class="degreeLabel-style-19"/>
            <ui:Label text="Label" name="statusLabel" class="statusLabel-style-20"/>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="signal" class="signal-style-21" style="overflow: visible; display: flex; visibility: visible; background-image: url(&quot;project://database/Assets/UI/icons2/flower7.png?fileID=2800000&amp;guid=d24f8011bb24c624eb7e60c3685560bb&amp;type=3#flower7&quot;);">
        <ui:Image class="dashboard-element-22"/>
        <ui:Image class="dashboard-element-23"/>
    </ui:VisualElement>
    <ui:VisualElement name="wiggle1" enabled="true" class="wiggle1-style-24" style="display: flex; visibility: visible;">
        <ui:Button text="&#10;" class="dashboard-element-25"/>
    </ui:VisualElement>
    <ui:VisualElement name="dialogue" focusable="true" class="bubble-element dialogue-style-27" style="visibility: visible; display: flex;">
        <ui:Button text="" name="closeButton" class="closeButton-style-28"/>
    </ui:VisualElement>
    <ui:VisualElement name="sliders" class="bubble-element sliders-style-29"/>
    <ui:VisualElement name="sliders" class="hover-scaler bubble-element sliders-style-30" style="display: none; visibility: hidden;">
        <ui:VisualElement name="brightness" class="brightness-style-31">
            <ui:Label name="brightnessValueLabel" text="100%&#10;" class="brightnessValueLabel-style-32"/>
            <ui:VisualElement name="sunIcon" class="sunIcon-style-33"/>
            <ui:Button name="brightnessDecBtn" text="" class="hover-scaler brightnessDecBtn-style-34"/>
            <ui:Slider label="Slider" value="42" high-value="100" name="brightnessSlider" class="brightnessSlider-style-35" style="display: flex; visibility: visible;"/>
            <ui:Button name="brightnessIncBtn" text="" class="hover-scaler brightnessIncBtn-style-36">
                <ui:VisualElement picking-mode="Ignore" class="dashboard-element-37"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="Sound" class="Sound-style-38">
            <ui:VisualElement name="soundIcon" class="soundIcon-style-39"/>
            <ui:Button name="soundDecBtn" text="" class="hover-scaler soundDecBtn-style-40"/>
            <ui:Slider label="Slider" value="42" high-value="100" name="soundSlider" class="soundSlider-style-41"/>
            <ui:Button name="soundIncBtn" text="" class="hover-scaler soundIncBtn-style-42">
                <ui:VisualElement picking-mode="Ignore" class="dashboard-element-43"/>
            </ui:Button>
            <ui:Label name="soundValueLabel" text="100%" class="soundValueLabel-style-44"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="exit" picking-mode="Ignore" class="bubble-element exit-style-45"/>
    <ui:VisualElement name="exit" class="hover-scaler bubble-element exit-style-46"/>
    <ui:VisualElement name="refresh" class="bubble-element refresh-style-47"/>
    <ui:VisualElement name="refresh" class="hover-scaler bubble-element refresh-style-48"/>
    <ui:VisualElement name="dialogueBox" class="bubble-element dialogueBox-style-49"/>
    <ui:VisualElement name="dialogueBox" class="bubble-element dialogueBox-style-50">
        <ui:Button text="&#10;" name="inputButton" class="hover-scaler inputButton-style-51"/>
        <ui:Label text="output&#10;" name="outputDialogueLabel" focusable="false" picking-mode="Position" class="outputDialogueLabel-style-52"/>
        <ui:TextField label="" placeholder-text="Ask Robit" name="inputDialogueField" vertical-scroller-visibility="Auto" picking-mode="Position" multiline="true" auto-correction="true" select-all-on-focus="true" emoji-fallback-support="false" class="inputDialogueField-style-53"/>
    </ui:VisualElement>
    <ui:Button text="T" name="keyboard" class="bubble-element keyboard-style-54"/>
    <ui:Button text="" name="mick" class="bubble-element mick-style-55"/>
    <ui:VisualElement name="reminder" class="bubble-element reminder-style-56"/>
    <ui:VisualElement name="reminder" class="hover-scaler bubble-element reminder-style-57">
        <ui:VisualElement class="dashboard-element-58"/>
        <ui:VisualElement class="dashboard-element-59"/>
        <ui:Label text="Reminder" class="dashboard-element-60"/>
        <ui:VisualElement class="dashboard-element-61"/>
    </ui:VisualElement>
    <ui:VisualElement name="settingsView" picking-mode="Ignore" enabled="true" class="bubble-element settingsView-style-62">
        <ui:VisualElement name="zoom-picker" class="zoom-picker-style-63">
            <ui:Label text="         Display Scale" class="dashboard-element-64"/>
            <ui:VisualElement class="dashboard-element-65">
                <ui:Button name="zoom100Btn" text="100%" class="zoom100Btn-style-66"/>
                <ui:Button name="zoom125Btn" text="125%" class="zoom125Btn-style-67"/>
                <ui:Button name="zoom150Btn" text="150%" class="zoom150Btn-style-68"/>
                <ui:Button name="zoom200Btn" text="200%" class="zoom200Btn-style-69"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
