            <ui:VisualElement name="progress-track" class="progress-track">
                <ui:VisualElement name="progress-fill" class="progress-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="prompt-panel" class="prompt-panel" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Gouttes.ttf?fileID=12800000&amp;guid=26657f46fc3c6a84b8ce76e9e82ebf64&amp;type=3#Gouttes&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="prompt-card" class="prompt-card" style="background-color: rgba(255, 255, 255, 0.33); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; height: 105px; width: 360px; position: absolute; top: 108px; left: 15px; scale: 1 1; translate: 1042px 101px;">
                <ui:Label name="point-label" text="" class="point-label" style="color: rgba(57, 109, 94, 240); -unity-font-definition: url(&quot;project://database/Assets/UI/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=9a78a73fc1aee3e46b312389b1b26a0d&amp;type=3#NotInter-Regular&quot;);"/>
                <ui:Label name="status-label" text="Initializing…" class="status-label" style="color: rgba(255, 255, 255, 230); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Momentz.otf?fileID=12800000&amp;guid=7ab166e8de88a5c4d8862fbfbdcd5ab2&amp;type=3#Momentz&quot;); font-size: 36px; height: 113px; width: 666px; -unity-text-align: middle-center; translate: 0 -11px;"/>
