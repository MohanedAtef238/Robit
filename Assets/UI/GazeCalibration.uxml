            <ui:Label name="fitting-label" text="Fitting gaze model…" class="fitting-label" style="color: rgba(255, 255, 255, 240); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Momentz.otf?fileID=12800000&amp;guid=7ab166e8de88a5c4d8862fbfbdcd5ab2&amp;type=3#Momentz&quot;);"/>
