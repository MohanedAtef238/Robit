    <ui:VisualElement name="calibration-root" class="calibration-root" style="background-image: url(&quot;project://database/Assets/My%20Color%20Theme%20(1).jpg?fileID=2800000&amp;guid=a77a74e41c678524eb2b8f4f37260807&amp;type=3#My Color Theme (1)&quot;); background-color: rgba(215, 240, 220, 0);">
