/* ─── Root ──────────────────────────────────────────────────────────────── */
/*  CRITICAL: zero padding/margin so that left/top percentages map 1:1      */
/*  to the logical panel rectangle with no artificial offset.               */
.calibration-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    background-color: rgb(215, 240, 220);
    overflow: hidden;
}

/* ─── Prompt panel — centred horizontally in the dead zone between rows ────── */
/*                                                                               */
/*  Calibration dot Y layout (normalised):                                       */
/*    Row 1 (top):        Y = 4.6%                                              */
/*    Row 2 (inner-top):  Y = 27.3%   ← last row above the gap                 */
/*    *** DEAD ZONE: 27.3% – 50% — no dots exist here ***                      */
/*    Row 3 (mid/center): Y = 50%                                               */
/*    Row 4 (inner-bot):  Y = 72.6%                                             */
/*    Row 5 (bottom):     Y = 95.4%                                             */
/*                                                                               */
/*  top: 30% lands ~2.7 % below the inner-top row bottom edge on any screen:   */
/*    1920×1080 → 324 px from top  (inner-top dot bottom ≈ 317 px) → +7 px     */
/*    2560×1440 → 432 px from top  (inner-top dot bottom ≈ 416 px) → +16 px    */
/*  It is also ~20 % above the center dot, so it never interferes with it.      */
.prompt-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    align-items: center;
    justify-content: flex-start;
}

.prompt-card {
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 200);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(80, 160, 100, 200);
    border-right-color: rgba(80, 160, 100, 200);
    border-top-color: rgba(80, 160, 100, 200);
    border-bottom-color: rgba(80, 160, 100, 200);
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 28px;
    padding-bottom: 28px;
    min-width: 360px;
}

.point-label {
    color: rgba(0, 100, 40, 240);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.status-label {
    color: rgba(0, 0, 0, 230);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

/* ─── Calibration dot ───────────────────────────────────────────────────── */
/*                                                                           */
/*  SIZE: 45 × 45 px                                                        */
/*  The C# controller sets `dot.style.left` and `dot.style.top` to         */
/*  Length.Percent(x * 100) and Length.Percent(y * 100).                   */
/*                                                                           */
/*  Those percentages are relative to the PARENT container width/height.   */
/*  The parent is .calibration-root which is zero-padding 100% × 100%.    */
/*                                                                           */
/*  The negative margins shift the origin from the dot's top-left corner   */
/*  to its exact visual center:                                             */
/*    margin-left: -(45/2) = -22.5 px                                      */
/*    margin-top:  -(45/2) = -22.5 px                                      */
/*                                                                           */
.calibration-dot {
    position: absolute;
    width: 45px;
    height: 45px;
    margin-left: -22px;
    margin-top: -22px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgb(220, 30, 30);
    /* White ring for maximum contrast on any background */
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    transition-property: left, top, background-color, opacity;
    transition-duration: 0.1s, 0.1s, 0.2s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease, ease;
}

/* Collecting state: blue while frames being captured */
.calibration-dot.dot-collecting {
    background-color: rgb(30, 100, 255);
}

/* Done state: green confirmation flash */
.calibration-dot.dot-done {
    background-color: rgb(0, 190, 70);
}

/* ─── Debug grid dot (static, no animation) ────────────────────────────── */
/*  Spawned by C# debug overlay — identical size/centering as live dot     */
.debug-dot {
    position: absolute;
    width: 45px;
    height: 45px;
    margin-left: -22px;
    margin-top: -22px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgb(255, 50, 50);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    opacity: 0.85;
}

/* Index label inside each debug dot */
.debug-dot-label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ─── Progress bar (sits below the live dot, auto-centred) ──────────────── */
.progress-track {
    position: absolute;
    bottom: -14px;
    left: 50%;
    width: 60px;
    height: 5px;
    margin-left: -30px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgba(0, 0, 0, 50);
    overflow: hidden;
}

.progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgb(40, 120, 255);
    transition-property: width;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

/* ─── Fitting overlay (shown while SVR model trains) ────────────────────── */
.fitting-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(215, 240, 220, 230);
    align-items: center;
    justify-content: center;
}

.fitting-label {
    color: rgba(0, 0, 0, 240);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}
