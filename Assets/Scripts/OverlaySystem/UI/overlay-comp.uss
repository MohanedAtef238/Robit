:root {
    /* pointer-events not supported in USS — picking-mode is set per-element in code */
}

.circular-buttons {
    width: 80px;
    height: 80px;
    border-top-left-radius: 9999px;
    border-top-right-radius: 9999px;
    border-bottom-right-radius: 9999px;
    border-bottom-left-radius: 9999px;
    background-color: rgb(80, 110, 160);
    -unity-background-image-tint-color: rgb(200, 220, 255);
    background-size: 24px 24px;
    transition-property: background-color, scale;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
    scale: 1;
}

.circular-buttons:hover {
    /* MODERN: blue — classic was: rgb(110, 70, 220) */
    background-color: rgb(55, 100, 190);
    scale: 1.1;
}

.circular-buttons:active {
    scale: 0.93;
    background-color: rgb(35, 70, 140);
}

.circular-buttons.unity-button--with-icon .unity-button__image {
    width: 24px;
    height: 116px;
}

.button-look {
    border-radius: 9999px;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(111, 111, 111, 0.66);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    color: white;
    font-size: 16px;
}

.icons {
    width: 24px;
    height: 24px;
    top: auto;
    bottom: -2px;
}
