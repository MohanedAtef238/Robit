:root {
    --circle-size: 64px;
}

/* Base reset for generic overlay Buttons.
   Width, height and margin are intentionally omitted here so that
   class-level rules (.macro-button, .wheel-arrow, .circular-buttons, etc.)
   are the sole source of sizing — no type-selector override fights. */
Button {
    border-radius: 9999px;
    padding: 0;
    justify-content: center;
    align-items: center;
    unity-text-align: middle-center;
}


