.selector-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.selector-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.selector-shell {
    width: 1450px;
    max-width: 96%;
    padding-top: 48px;
    padding-right: 40px;
    padding-bottom: 48px;
    padding-left: 40px;
    align-items: center;
}

.selector-title {
    color: rgba(216, 255, 242, 0.98);
    font-size: 38px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.selector-subtitle {
    color: rgba(203, 222, 236, 0.9);
    font-size: 20px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.selector-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    align-items: center;
    width: 100%;
}

.selector-option {
    width: 380px;
    height: 440px;
    margin-top: 25px;
    margin-right: 28px;
    margin-bottom: 25px;
    margin-left: 28px;
}

.selector-option .card {
    background-color: rgba(18, 24, 36, 0.22);
    border-color: rgba(0, 255, 170, 0.55);
}

.selector-option:hover .card {
    background-color: rgba(44, 28, 76, 0.30);
    border-color: rgba(155, 89, 245, 0.95);
}

.selector-number {
    opacity: 1;
    top: 50%;
    translate: 0 -58%;
    font-size: 148px;
    color: rgba(179, 136, 255, 1);
    text-shadow: 0 0 24px rgba(140, 80, 255, 0.45);
}

.selector-option:hover .selector-number {
    opacity: 1;
    translate: 0 -58%;
}

.selector-hint {
    bottom: 26px;
    translate: 0 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: rgba(233, 239, 245, 0.82);
}

.selector-option--disabled {
    opacity: 0.46;
}

.selector-option--disabled .card {
    border-color: rgba(109, 120, 138, 0.28);
    background-color: rgba(16, 18, 24, 0.12);
}

.selector-option--disabled .selector-number {
    color: rgba(130, 137, 151, 0.9);
    text-shadow: none;
}
