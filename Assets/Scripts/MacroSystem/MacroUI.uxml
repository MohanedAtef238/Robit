<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MacroUI.uss" />
    <ui:VisualElement name="macro-container" class="macro-container">

        <!-- Group name label that fades in/out on page change -->
        <ui:Label name="group-name-label" class="group-name-label" text="" />

        <ui:VisualElement name="button-grid" class="button-grid">
            <!-- 3 reusable macro button slots — controller swaps icons/bindings per group -->
            <MacroButton name="BtnSlot0" class="macro-button">
                <ui:VisualElement name="BtnSlot0Icon" class="btn-icon" />
            </MacroButton>
            <MacroButton name="BtnSlot1" class="macro-button">
                <ui:VisualElement name="BtnSlot1Icon" class="btn-icon" />
            </MacroButton>
            <MacroButton name="BtnSlot2" class="macro-button">
                <ui:VisualElement name="BtnSlot2Icon" class="btn-icon" />
            </MacroButton>
            <ui:Button name="BtnWheelPrev" class="wheel-arrow arrow-left">
                <ui:VisualElement class="arrow-icon" />
            </ui:Button>
            <ui:Button name="BtnWheelNext" class="wheel-arrow arrow-right">
                <ui:VisualElement class="arrow-icon" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
