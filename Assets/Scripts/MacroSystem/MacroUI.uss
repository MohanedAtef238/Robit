/* Per-button name tooltip — floats above each button briefly */
.button-tooltip {
    position: absolute;
    -unity-text-align: middle-center;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(215, 195, 255, 0.92);
    white-space: nowrap;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-in-out;
}

/* Wheel cycling arrows */
.wheel-arrow {
    position: absolute;
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(215, 195, 255, 0.9);
    background-color: rgba(196, 153, 252, 0.85);
    border-width: 1px;
    border-color: rgba(120, 80, 225, 0.50);
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.wheel-arrow:hover {
    background-color: rgba(80, 50, 175, 0.95);
    border-color: rgba(160, 110, 255, 0.85);
}

/* Arrow icon inside wheel buttons */
.wheel-arrow .arrow-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.95);
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/curved-arrow-right.png");
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    margin: 0;
    align-self: center;
}
