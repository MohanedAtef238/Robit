
:root {
    --spacing-xs: 6px;
    --spacing-sm: 8px;
    --spacing-md: 12px;
    --spacing-lg: 16px;
    --button-size: 70px;
    --button-icon-size: 34px;
    --container-width: 180px;
    --container-right: 24px;
    --container-top: 12%;
    --container-radius: 16px;
    --container-bg: rgba(20, 15, 55, 0.60);
    --container-border: rgba(100, 60, 210, 0.30);
    --button-bg: rgb(185, 160, 240);
    --button-bg-hover: rgb(90, 50, 195);
    --button-bg-active: rgb(65, 30, 165);
    --button-border: rgb(65, 35, 145);
    --button-border-hover: rgb(160, 110, 255);
    --icon-color: rgb(20, 10, 55);
    --icon-hover-color: rgb(255, 255, 255);
}

.macro-container {
    position: absolute;
    right: var(--container-right);
    top: var(--container-top);
    width: var(--container-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--container-bg);
    border-radius: var(--container-radius);
    padding: var(--spacing-lg) var(--spacing-md);
    border-width: 1px;
    border-color: var(--container-border);
    opacity: 1;
}

/* Editor-preview layout: single row so all buttons are visible.
   At runtime MacroButtonController switches every button to
   position:absolute and places them on the arc — this flex
   layout is only active in UI Builder / scene view. */
.button-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: visible;
}


.macro-button {
    width: var(--button-size);
    height: var(--button-size);
    margin: var(--spacing-md);
    border-radius: 50%;
    background-color: var(--button-bg);
    border-width: 1.5px;
    border-color: var(--button-border);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    scale: 1;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-property: background-color, border-color, scale;
}

.macro-button:hover {
    background-color: var(--button-bg-hover);
    border-color: var(--button-border-hover);
    scale: 1.12;
}

.macro-button:active {
    background-color: var(--button-bg-active);
    scale: 0.92;
}

/* .home-button intentionally inherits all sizing from .macro-button.
   Add overrides here only if the home button needs a different look. */
.home-button {}

.btn-icon {
    width: var(--button-icon-size);
    height: var(--button-icon-size);
    -unity-background-image-tint-color: var(--icon-color);
    background-size: contain;
}

.macro-button:hover .btn-icon {
    -unity-background-image-tint-color: var(--icon-hover-color);
}

.icon-zoom-in {
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/zoom_in.png?fileID=2800000&guid=6e6ea39182f9d8a46a6d5af65b2f1d27&type=3#zoom_in");
}

.icon-zoom-out {
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/zoom_out.png?fileID=2800000&guid=aa3bda48e56a2e941ad88a004820ed9e&type=3#zoom_out");
}

.icon-page-up {
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/page_up.png?fileID=2800000&guid=355ee87013fa81044850926e11871dda&type=3#page_up");
}

.icon-page-down {
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/page_down.png?fileID=2800000&guid=1ffdaf5ccf4ebab4aa4df8b745d16a7b&type=3#page_down");
}

.icon-home {
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/home.png?fileID=2800000&guid=4b28b571169ad6b41b1d22188ad26c66&type=3#home");
}

.icon-home-dashboard {
    background-image: url("project://database/Assets/home_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg?fileID=7388822144124034973&guid=dea5b8579094e934787515890995c206&type=3#home_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24");
}

.icon-settings {
    background-image: url("project://database/Assets/settings_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg?fileID=7388822144124034973&guid=d671468dc8e08a343ab4eca2623f67b6&type=3#settings_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24");
}

/* Wheel cycling arrows */
.wheel-arrow {
    position: absolute;
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(215, 195, 255, 0.9);
    background-color: rgba(196, 153, 252, 0.85);
    border-width: 1px;
    border-color: rgba(120, 80, 225, 0.50);
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.wheel-arrow:hover {
    background-color: rgba(80, 50, 175, 0.95);
    border-color: rgba(160, 110, 255, 0.85);
}

/* Arrow icon inside wheel buttons */
.wheel-arrow .arrow-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.95);
    background-image: url("project://database/Assets/Scripts/MacroSystem/Icons/curved-arrow-right.png");
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    margin: 0;
    align-self: center;
}
