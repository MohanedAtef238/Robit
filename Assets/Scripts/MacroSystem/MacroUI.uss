:root {
    --button-size: 72px;
    --button-icon-size: 36px;
    
    --container-bg: rgba(18, 28, 48, 0.65);
    --container-border: rgba(80, 120, 200, 0.28);
    --button-bg: #88D399; /* pastel green */
    --button-bg-hover: #D4A5E8; /* pastel purple */
    --button-bg-active: #B484C8;
    --button-border: #000000;
    --button-border-hover: #000000;
    --icon-color: rgb(15, 20, 40);
    --icon-hover-color: rgb(255, 255, 255);
}

.macro-container {
    position: absolute;
    right: 12%; /* Anchored to bottom right near mascot */
    bottom: 12%;
    margin-bottom: 0px; /* Reduced from 200px to fix floating too high since SetWorldAnchor provides position */
    width: 120px;
    height: auto; 
    translate: 50% 50%;
    
    /* Make the central container/pivot completely invisible */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    
    display: flex;
    flex-direction: column; /* FORCES VERTICAL LINE STACKING */
    justify-content: center;
    align-items: center;
    
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.button-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
}

.macro-button {
    position: relative; 
    margin-bottom: 5px; /* Tighter spacing to restore the original clustered look */
    width: var(--button-size);
    height: var(--button-size);
    border-radius: 50%;
    background-color: var(--button-bg);
    border-width: 3px;
    border-color: var(--button-border);
    align-items: center;
    justify-content: center;
    overflow: visible;
    
    /* Transition translate property alongside opacity and scale */
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    transition-property: opacity, scale, translate, background-color;
}

/* Individual Slot Styling (Migrated from inline UXML) */
.slot-0, .slot-2 {
    border-width: 6px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(176, 249, 222, 0.37);
}

.slot-1 {
    border-width: 6px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(204, 176, 249, 0.37);
}

/* Slot 1 gets scaled to 1.5 normally. */
.macro-state--visible.slot-1 {
    scale: 1.5;
}

.slot-prev, .slot-next {
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.45);
    scale: 0.8;  /* Smaller than the macro action buttons */
}

/* Dark icon on white background — consistent for both arrows */
.slot-prev .btn-icon, .slot-next .btn-icon {
    -unity-background-image-tint-color: rgb(15, 20, 40);
}

/* Restore reactive hover/active — these now work because there are no inline styles blocking them */

/* Active MVVM State Classes */
.macro-state--visible {
    opacity: 1;
    scale: 1;
}

.macro-state--hidden {
    opacity: 0;
    scale: 0.2;
}

/* Hover States */
.macro-button:hover {
    scale: 1.15;
}

/* Individual Background Hovers */
.slot-0:hover, .slot-2:hover {
    background-color: rgba(176, 249, 222, 0.9);
}

.slot-1:hover {
    background-color: rgba(204, 176, 249, 0.9);
    scale: 1.6; /* Preserve pop for middle button */
}

.slot-prev:hover, .slot-next:hover {
    background-color: rgb(220, 220, 220);
}

/* Active States */
.macro-button:active {
    scale: 0.92;
}

.slot-0:active, .slot-2:active {
    background-color: rgba(176, 249, 222, 0.5);
}

.slot-1:active {
    background-color: rgba(204, 176, 249, 0.5);
    scale: 1.4;
}

.slot-prev:active, .slot-next:active {
    background-color: rgb(180, 180, 180);
}

/* Group Label */
.group-name-label {
    position: absolute;
    top: 100%; /* Keeps it neatly below the entire vertical button list */
    margin-top: 15px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(170, 200, 245, 0.95);
    background-color: var(--container-bg);
    border-width: 2px;
    border-color: var(--container-border);
    border-radius: 12px;
    padding: 8px 16px;
    transition-duration: 0.3s;
}

.label-state--visible { opacity: 1; scale: 1; }
.label-state--hidden { opacity: 0; scale: 0.5; }

/* Tooltips */
.button-tooltip {
    position: absolute;
    top: 50%;
    right: 120%;
    translate: 0 -50%; /* Centers them vertically against the button */
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(170, 200, 245, 0.95);
    white-space: nowrap;
    background-color: var(--container-bg);
    border-width: 1px;
    border-color: var(--container-border);
    border-radius: 8px;
    padding: 8px 12px;
    transition-property: opacity, scale;
    transition-duration: 250ms;
}

/* Icons */
.btn-icon {
    width: var(--button-icon-size);
    height: var(--button-icon-size);
    -unity-background-image-tint-color: var(--icon-color);
    background-size: contain;
}

.macro-button:hover .btn-icon {
    -unity-background-image-tint-color: var(--icon-hover-color);
}

