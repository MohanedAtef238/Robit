/* --- CLEAN SOFTER PASTEL GREEN CARD COMPONENT --- */

.container {
    position: relative;
    width: 270px;
    height: 360px;
    margin: 20px; 
    transition-duration: 200ms;
    opacity: 1;
    scale: 1;
}

.container.card-hidden {
    opacity: 0;
    scale: 0.7;
}

.container.card-visible {
    opacity: 1;
    scale: 1;
}

.container:active {
    scale: 0.95;
}

.card {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    transition-duration: 300ms;
    /* Soft, translucent sage base */
    background-color: rgba(30, 45, 35, 0.4); 
    border-width: 1.5px;
    border-color: rgba(153, 204, 153, 0.25);
    overflow: hidden;
}

.card:hover {
    transition-duration: 200ms;
    background-color: rgba(45, 65, 50, 0.6); 
    scale: 1.05;
    border-color: rgba(153, 204, 153, 0.8);
}

.card-glow-bg {
    position: absolute;
    width: 150%;
    height: 150%;
    left: -25%;
    top: -25%;
    background-color: rgba(153, 204, 153, 0.05);
    border-radius: 50%;
    opacity: 0;
    transition-duration: 300ms;
}

.container:hover .card-glow-bg {
    opacity: 1;
}

.card-border-accent {
    position: absolute;
    bottom: 0; left: 15%; right: 15%;
    height: 3px;
    border-radius: 1.5px;
    background-color: rgba(153, 204, 153, 0.0);
    transition-duration: 300ms;
}

.container:hover .card-border-accent {
    background-color: rgba(153, 204, 153, 0.8);
    bottom: 20px; /* Rises up nicely on hover */
}

.card-content {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

#prompt {
    bottom: 30px;
    position: absolute;
    width: 100%;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-duration: 300ms;
    -unity-text-align: middle-center;
    color: rgba(207, 255, 207, 0.9);
    text-shadow: 0 0 10px rgba(153, 204, 153, 0.5);
    opacity: 0;
}

.container:hover #prompt {
    opacity: 1;
    bottom: 45px; /* Appears clearly above the accent line (which is at bottom: 20px) */
}

.icon-container {
    position: absolute;
    top: 65px;
    width: 100%;
    height: 100px;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-duration: 300ms;
}

.container:hover .icon-container {
    opacity: 0.15; /* Fade out icon so title is clear */
    scale: 0.85;
}

.title {
    opacity: 1;
    transition-duration: 300ms;
    position: absolute;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    width: 100%;
    top: 185px;
    color: rgba(230, 245, 230, 0.9);
    white-space: normal;
    padding-left: 15px;
    padding-right: 15px;
}

.container:hover .title {
    color: #ffffff;
    text-shadow: 0 0 15px rgba(153, 204, 153, 0.6);
}

.subtitle {
    position: absolute;
    bottom: 25px;
    width: 100%;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(153, 204, 153, 0.6);
}

.tracker {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
