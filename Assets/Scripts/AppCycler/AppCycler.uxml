<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="AppCycler.uss" />

    <!-- Invisible hover zone near the bottom edge to detect proximity -->
    <ui:VisualElement name="cycler-hit-area" class="cycler-hit-area">

        <!-- Main dock that slides up/down -->
        <ui:VisualElement name="cycler-dock" class="cycler-dock cycler-dock--tucked">

            <!-- Single idle circle (visible before split) -->
            <ui:Button name="cycler-idle-btn" class="cycler-idle-circle">
                <ui:VisualElement class="cycler-idle-icon" />
            </ui:Button>

            <!-- Expanded row: left arrow + app name + right arrow (hidden initially) -->
            <ui:VisualElement name="cycler-expanded" class="cycler-expanded" style="display: none;">
                <ui:Button name="cycler-left" class="cycler-arrow cycler-arrow--left cycler-arrow--collapsed">
                    <ui:VisualElement class="cycler-arrow-icon" />
                </ui:Button>

                <ui:Button name="cycler-label-btn" class="cycler-label-container cycler-label-container--hidden">
                    <ui:Label name="cycler-app-name" class="cycler-label" text="App Name" />
                </ui:Button>

                <ui:Button name="cycler-right" class="cycler-arrow cycler-arrow--right cycler-arrow--collapsed">
                    <ui:VisualElement class="cycler-arrow-icon" />
                </ui:Button>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
