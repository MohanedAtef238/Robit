<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/ModernNamePrompt.uss" />
    <ui:VisualElement name="overlay" class="prompt-overlay">
        <ui:VisualElement name="panel" class="prompt-panel">
            <ui:Label text="Enter Profile Name" class="prompt-title" />
            <ui:TextField name="input-name" class="prompt-input" picking-mode="Ignore" />
            <ui:VisualElement class="btn-container">
                <ui:Button name="btn-create" text="Create" class="btn btn-create" />
                <ui:Button name="btn-cancel" text="Cancel" class="btn btn-cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
